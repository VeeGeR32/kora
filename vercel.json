{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://kora-d6019.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://kora-d6019.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/((?!api/|__/).*)",
      "destination": "/index.html"
    }
  ]
}
